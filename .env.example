# Provider configuration is read by the native desktop process only.
# Never commit real client IDs, client secrets, or tokens.
# Redirect URIs are generated per authorization attempt on an ephemeral loopback port.
# Register the exact URI printed by the running desktop app; do not configure a fixed port here.

AURORA_SPOTIFY_ENABLED=false
AURORA_SPOTIFY_CLIENT_ID=
AURORA_SPOTIFY_CLIENT_SECRET=
AURORA_SPOTIFY_AUTH_URL=https://accounts.spotify.com/authorize
AURORA_SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
AURORA_SPOTIFY_API_URL=https://api.spotify.com
AURORA_SPOTIFY_SCOPES=user-read-email playlist-read-private playlist-modify-public playlist-modify-private
AURORA_SPOTIFY_REDIRECT_URI=https://api.example.com/api/oauth/spotify/callback

AURORA_YOUTUBE_MUSIC_ENABLED=false
AURORA_YOUTUBE_MUSIC_CLIENT_ID=
AURORA_YOUTUBE_MUSIC_CLIENT_SECRET=
AURORA_YOUTUBE_MUSIC_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
AURORA_YOUTUBE_MUSIC_TOKEN_URL=https://oauth2.googleapis.com/token
AURORA_YOUTUBE_MUSIC_API_URL=https://www.googleapis.com/youtube/v3
AURORA_YOUTUBE_MUSIC_SCOPES=openid email profile https://www.googleapis.com/auth/youtube
AURORA_YOUTUBE_MUSIC_REDIRECT_URI=https://api.example.com/api/oauth/youtube-music/callback
# Browser API: production must use HTTPS, exact origins, and durable encrypted storage.
AURORA_API_ALLOWED_ORIGINS=https://app.example.com
AURORA_API_FRONTEND_URL=https://app.example.com/settings/accounts
# The initial API binary intentionally refuses to start without these values.
# Provider secrets belong only in the API process, never in frontend variables.

# Desktop redirect URIs are generated at runtime on an ephemeral loopback port.
# Register the exact URI shown by the desktop coordinator; do not set a fixed port.
